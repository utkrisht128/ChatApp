# Copy to apps/server/.env for local development. Never commit the real file.

NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/chatapp  ·  Production: MongoDB Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/chatapp

# Browser origin(s) of the frontend, comma-separated (used for CORS, CSRF origin checks, email links).
# The first entry is used to build links in emails.
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the server (Render = 1). Used to read the real client IP.
TRUST_PROXY=1

SESSION_TTL_DAYS=30
LOG_LEVEL=info

# Optional. smtp(s)://user:pass@host:port — when unset in development, email links are printed to the console.
SMTP_URL=
MAIL_FROM="ChatApp <no-reply@example.com>"

# Optional. Web Push keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Uploads are stored in MongoDB GridFS (Atlas M0 has 512 MB total), so keep these small.
MAX_UPLOAD_MB=8
USER_STORAGE_QUOTA_MB=100

# Optional. Comma-separated emails that are granted the admin role when they register or log in.
ADMIN_EMAILS=
