# Copy to apps/web/.env.local for local development.

# Direct origin of the API server for the WebSocket connection (REST goes through /api on the same origin).
# Development: http://localhost:5000  ·  Production: https://<your-service>.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Optional: Web Push public key (must match the server's VAPID_PUBLIC_KEY).
VITE_VAPID_PUBLIC_KEY=

# Development only: where Vite proxies /api (defaults to http://localhost:5000).
DEV_API_TARGET=http://localhost:5000

# Build time (Netlify): origin that /api/* is proxied to. Used to generate dist/_redirects.
# API_ORIGIN=https://<your-service>.onrender.com
